#!/usr/bin/env python3
"""Control hyprsunset; the schedule lives in ~/.config/hypr/hyprsunset.conf."""
import json
import subprocess
import sys

def active():
    return subprocess.run(['systemctl','--user','is-active','--quiet','hyprsunset.service']).returncode == 0

action=sys.argv[1] if len(sys.argv)>1 else 'status'
if action=='status':
    enabled=active()
    temperature=''
    if enabled:
        result=subprocess.run(['hyprctl','hyprsunset','temperature'],text=True,capture_output=True)
        candidate=result.stdout.strip()
        if candidate.isdigit(): temperature=f' · {candidate}K'
    print(json.dumps({'text':'󰖔' if enabled else '󰖙',
        'class':'enabled' if enabled else 'disabled',
        'tooltip':('Warm display'+temperature if enabled else 'Warm display off')+
        '\nClick: toggle · Right-click: restore schedule'}))
elif action in ('toggle','reset'):
    command=('stop' if active() else 'start') if action=='toggle' else 'restart'
    subprocess.run(['systemctl','--user',command,'hyprsunset.service'],check=True)
else:
    raise SystemExit('Usage: warm-display [status|toggle|reset]')
