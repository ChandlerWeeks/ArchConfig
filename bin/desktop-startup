#!/usr/bin/env bash
set -euo pipefail
# Services need the compositor environment even without a session wrapper.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE
systemctl --user start hyprpolkitagent.service swaync.service hyprsunset.service cliphist-text.service cliphist-image.service waybar.service
