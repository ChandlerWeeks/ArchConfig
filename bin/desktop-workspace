#!/usr/bin/env python3
"""Cycle all existing workspaces on the focused monitor, including empty ones."""
import fcntl
import json
import os
import subprocess
import sys
from pathlib import Path
lock=Path(os.environ.get('XDG_RUNTIME_DIR','/tmp')) / f'desktop-workspace-{os.getuid()}.lock'
with lock.open('w') as handle:
    fcntl.flock(handle, fcntl.LOCK_EX)
    def query(name):
        return json.loads(subprocess.check_output(['hyprctl','-j',name]))
    monitor=next(m for m in query('monitors') if m['focused'])
    current=monitor['activeWorkspace']['id']
    workspaces=sorted({w['id'] for w in query('workspaces')
                       if w['monitor']==monitor['name'] and w['id']>0})
    if len(workspaces)>1:
        step=-1 if sys.argv[1]=='previous' else 1
        target=workspaces[(workspaces.index(current)+step)%len(workspaces)]
        subprocess.run(['hyprctl','dispatch','workspace',str(target)],check=True,stdout=subprocess.DEVNULL)
