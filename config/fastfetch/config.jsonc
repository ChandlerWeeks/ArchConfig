{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/nyarch-logo.png",
    "type": "kitty-direct",
    "width": 28,
    "height": 14,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#cba6f7",
      "title": "#f5c2e7",
      "output": "#cdd6f4"
    }
  },
  "modules": [
    "break",
    "title",
    {
      "type": "custom",
      "format": "────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "kernel",
      "key": " Kernel"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "wm",
      "key": " Desktop"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": " CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": " Memory"
    },
    {
      "type": "uptime",
      "key": "󰥔 Uptime"
    },
    {
      "type": "custom",
      "format": "󰄛  nya~ make yourself at home",
      "outputColor": "#f5c2e7"
    },
    "break"
  ]
}
