#!/usr/bin/env bash
set -euo pipefail
# Download assets only, using the versioned official Catppuccin release.
name=catppuccin-mocha-mauve-standard+default
destination="${XDG_DATA_HOME:-$HOME/.local/share}/themes"
if [[ -d "$destination/$name" ]]; then
    printf 'GTK theme already installed: %s\n' "$destination/$name"
    exit 0
fi
archive=$(mktemp --suffix=.zip)
trap 'rm -f "$archive"' EXIT
curl -fL --retry 2 -o "$archive" 'https://github.com/catppuccin/gtk/releases/download/v1.0.3/catppuccin-mocha-mauve-standard%2Bdefault.zip'
mkdir -p "$destination"
unzip -q "$archive" -d "$destination"
printf 'Installed %s\n' "$destination/$name"
